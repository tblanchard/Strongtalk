colSize ^ (self at: 1) size! !

"December 10, 2001 -> 14:25:52"!

! (Delta mirrorFor: #IntMM2Matrix) methodsFor: 'misc' !
init: bench
	| temp |
	1 to: self rowSize do: [ :i |
		1 to: self colSize do: [ :j |
			temp := bench newValue.
			(self at: i) at: j put: temp - ((temp // 120) * 120) - 60]]! !

"December 10, 2001 -> 14:25:52"!

! (Delta mirrorFor: #IntMM2Matrix) methodsFor: 'misc' !
rowSize ^self size! !

