into: hdc <HDC>
background: b <Boolean>
^<Win32Handle>

	Palette debugging
		ifTrue: [ Platform errorStream show: 'Palette>>select into: '; print: hdc; cr.	].
	^{{<gdi Win32Handle SelectPalette>
			hdc: hdc
			pal: paletteHandle
