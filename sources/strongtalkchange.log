! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
getCategoryName
	| name |
	name := self getEntryName.
	1 to: name size do: [ :i |
		(name at: i) isLetter ifFalse: [
			^name copyFrom: 1 to: i - 1 ]].
	^name
! !

