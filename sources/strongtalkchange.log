to: stop <Float> by: step <Float> do: f <[Float]> ^<Object>

	| v <Float> |
	v := self.
	step < 0.0
		ifFalse: [ [ v <= stop ]
					whileTrue: [	f value: v.
								v := v + step  ]]
		ifTrue: [ [ v >= stop ]
					whileTrue: [ f value: v.
								v := v + step  ]].
	^nil! !

