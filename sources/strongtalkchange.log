! (Delta mirrorFor: #TextEditor) methodsFor: 'private' !
promptDiscardChangesOnSuccess: blk <[]>

	self visual
		promptYesNo: 'Discard changes?'
		title: self windowTitle
		type: #exclamation
		default: 2
		action: [ :yes <Boolean> |
						yes ifTrue: [ blk value ]
					]! !

