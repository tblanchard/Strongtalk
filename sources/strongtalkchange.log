				self setPath: f.
				self textView acceptAndOnSuccess: blk.	]
		fileTypes: (Array[Tuple[Str,Str]] with: 'All Files' ,, '*.*' with: 'Text Files' ,, '*.txt' )
		defaultFile: self path
		defaultDir: nil
		title: 'Save File'! !

