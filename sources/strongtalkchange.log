! (Delta mirrorFor: #Platform) classSide methodsFor: 'Dynamic Linked Libraries' !
DLLLibrary: name
	^DLLDict at: name ifAbsent: [
		DLLDict at: name put: (self DLLLoad: name)
	]! !

