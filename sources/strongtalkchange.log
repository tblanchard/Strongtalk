! (Delta mirrorFor: #Queue) methodsFor: 'private' !
actualNext ^<E>

	| l <DoubleLink[E]> |
	l := self head.
	self head: l next.
	self head isNil
		ifTrue: [ self tail: self head ].
	self actualSize: self actualSize - 1.
	^l value! !

