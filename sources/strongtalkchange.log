toCompare: compare <[EL def,EL,^Boolean]>
^<Int>
			{where CONSTRAINER <EL> is returnType of #anElement message of receiverType}

	"The guarantee is safe because of the inference clause"
	^(guaranteed <SeqCltn[EL]> self)
			binarySearchFor: el
			between: 1
			and: self size
			toCompare: compare! !

