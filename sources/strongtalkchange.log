	self parent isNil
		ifTrue: [ m add: self filterMenu ].
	^m! !

"June 28, 2002 -> 16:22:10"!

! (Delta mirrorFor: #ClassHierarchyOutliner) methodsFor: 'menus' !
popUpMenu ^<Menu>

	| m <Menu> |
	m := Menu new
		addAll: self fileMenu removeAll;
		addSeparator;
		addAll: self viewMenu removeAll;
		addSeparator;
		add: self typecheckingMenu.
	self parent isNil
		ifTrue: [ m add: self filterMenu ].
	^m! !

