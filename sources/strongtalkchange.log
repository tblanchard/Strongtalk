! (Delta mirrorFor: #TaklBenchmark) methodsFor: 'misc' !
run
	"TaklBenchmark new run"
	| r |
	r := self taklX: (self listn: 18) Y: (self listn: 12) Z: (self listn: 6).
	(r = (self listn: 7)) ifFalse: [ self error: 'takl results are wrong' ]! !

