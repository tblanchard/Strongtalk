! (Delta mirrorFor: #ModifiedVisual) methodsFor: 'wrapper management' !
removeWrapper: w <VisualWrapper>
	"Remove an inner wrapper from the core part"

	self part == w
		ifFalse: [	self part withoutWrapper: w ]
		ifTrue: [	| p <Visual> |
						p := self removePart.
						self part: (p withoutWrapper: w).	]! !

