	maxX := p2 x.
	minY := p1 y.
	maxY := p2 y.
	minX > maxX
		ifTrue: [ tmp := minX.  minX := maxX. maxX := tmp ].
	minY > maxY
		ifTrue: [ tmp := minY.  minY := maxY. maxY := tmp ].

	^self left: minX right: maxX top: minY bottom: maxY! !

