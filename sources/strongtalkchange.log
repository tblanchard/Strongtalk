! (Delta mirrorFor: #RichardsBenchmarks) methodsFor: 'private' !
trace: id
    layout := layout - 1.
    0 >= layout
        ifTrue:
            [Transcript cr.
            layout := 50].
    Transcript show: id printString
! !

