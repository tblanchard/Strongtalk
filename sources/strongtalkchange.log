! (Delta mirrorFor: #SystemMonitor) methodsFor: 'private' !
startUpdateProcess

	[	| delay <Delay> |
		delay := Delay forMilliseconds: self updateDelay.
		[
			delay  wait.
			self monitorData: SystemMonitorData new.
			self addValuesToTable.
		] repeat
	] fork
! !

