! (Delta mirrorFor: #SeqCltnReadWriteStream) methodsFor: 'private' !
accumulateUntil: predicate <[^Boolean]>  ^<SeqCltn[E]>

	| start <Int> |

	start := self position.
	[ predicate value ]
		whileFalse: [ self position: self position + 1 ].
	^self buffer copyFrom: start + 1 to: self position! !

