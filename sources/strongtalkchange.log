filterMenu ^ <Menu>

^Menu new name: 'Filtering';
    add: (MenuAction new
                  name: 'Filter on ...';
                  action: [self promptForFilter]);
    add: (MenuAction new
                  name: 'Also Filter on ...';
                  action: [self promptForAdditionalFilter]);
    add: (MenuAction new
                  name: 'No Filtering';
                  action: [self clearFilter])  ! !

