! (Delta mirrorFor: #DeltaTypeErrorHandlerStack) methodsFor: 'Unclassified' !
definitionStack ^<Cltn[DeltaBasicLocator]>
	"Private"
	^definitionStack! !

"December 10, 2001 -> 14:22:35"!

! (Delta mirrorFor: #DeltaTypeErrorHandlerStack) methodsFor: 'Unclassified' !
definitionStack: ds <Cltn[DeltaBasicLocator]>
	"Private"
	definitionStack := ds! !

