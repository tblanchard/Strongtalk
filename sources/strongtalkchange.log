! (Delta mirrorFor: #CallBack) methodsFor: 'accessors' !
fetchArgument: arg stack: stack class: class
    | proxy |
    class = SmallInteger ifTrue: [^stack smallIntegerAt: arg * 4].
    proxy := class new.
    stack proxyAt: (arg * 4) result: proxy.
    ^proxy! !

