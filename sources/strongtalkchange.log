! (Delta mirrorFor: #TextEditor) methodsFor: 'private' !
doStoreAndOnSuccess: blk <[]>

	| strm <CharOutputStream> |
	strm := self path charOutputStream.
	[ self textView model do: [ :cg <CharacterGlyph> | strm put: cg character ] ]
		ensure: [ strm close ].
	blk value! !

