! (Delta mirrorFor: #TextEditor) methodsFor: 'menus' !
fileMenu ^<Menu>

	^Menu new name: '&File';
			add: (MenuAction new
					name: '&Open...';
					action: [ self open ]);
			add: (MenuAction new
					name: '&Save';
					active: [ self hasPath ];
					action: [ self save ] );
			add: (MenuAction new
					name: 'Save &As...';
					action: [ self saveAs ]);
			add: (MenuAction new
					name: '&Restore Original';
					action: [ self cancel ]);
			add: (MenuAction new
					name: 'E&xit';
					action: [ self visual topWindow requestClose ]);
		 addSeparator;
		 add: (MenuAction new
		            name:'Meta';
		            action:[Inspector launchOn: self])! !

