register: block parameters: params
    | new index |
    new   := super new.
    index := CallBackArray add: new.
    {{primitiveCallBackRegisterPascalCall: CallBackArray size
                         numberOfArguments: params size
                                    result: new ifFail: [:err | self error: err]}}.
    new parameters: params.
    new block: block.
    ^new
