! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
errorString
	| col str |
	col := self getAttribute: #error ifAbsent: [^''].
	str := ''.
	col do: [ :v |
		str := str, v value asString.
	] andBetweenDo: [
		str := str, ' '
	].
	^str! !

