! (Delta mirrorFor: #SieveBenchmark) methodsFor: 'misc' !
run
	| size iter flags prime k |
	size := 8190.
	iter := 10.
	flags := (Array new: size + 1)
				atAllPut: true.
	iter timesRepeat: [
		0 to: size do: [:i | (flags at: i + 1) ifTrue: [
			prime := i + i + 3.
			k := i + prime.
			[k <= size] whileTrue: [
				flags at: k put: false.
				k := k + prime]]]]
	"SieveBenchmark new run"! !

