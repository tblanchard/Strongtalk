! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
canBeConstantFolded
    | value |
    value := false.
    self flagsDo: [ :name |
        name == #Pure ifTrue: [ value := true ].
    ].
    ^value! !

"December 10, 2001 -> 14:0:24"!

! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
canPerformNLR
    | value |
    value := false.
    self flagsDo: [ :name |
        name == #NLR  ifTrue: [ value := true ].
    ].
    ^value! !

"December 10, 2001 -> 14:0:24"!

! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
canScavenge
    | value |
    value := true.
    self flagsDo: [ :name |
        name == #Pure            ifTrue: [ value := false ].
        name == #Function    ifTrue: [ value := false ].
    ].
    ^value! !

