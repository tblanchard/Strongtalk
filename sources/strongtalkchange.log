! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
turn: delta <Int>

	| a <Int> |
	a := angle + delta.
	a < 0 ifTrue: [ a := a + 360 ]
		ifFalse: [ a >= 360 ifTrue: [ a := a - 360 ] ].
	angle := a! !

