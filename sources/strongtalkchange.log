				c size = 2 and: [ (c at: 1) = 1 and: [ (c at: 2) = 10 ]]		].
	self test: 9 is: [ ('hi there' findLast: [ :c <Character> | c = $e ]) = 8 ].
	self test: 10 is: [ ('hi there' indexOf: $t) = 4 ].
