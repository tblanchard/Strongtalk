! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
wndProc:  hwnd <ExternalData>
message:  msgType <SmallInteger>
wParam:  wParam <ExternalData>
lParam:  lParam <ExternalData>
^<ExternalData>

	| result <ExternalData> |
Transcript show: '		in wndproc: '; show: (MSG descriptionOf: msgType asExternalProxy); cr.
	msgType @= Win32 WM_PAINT
		ifTrue: [	|	hdc <ExternalData>
							ps <PAINTSTRUCTURE>
							rect <RECT>
							text <ExternalProxy> |
						ps := PAINTSTRUCT new allocate.
						rect := RECT new allocate.

						hdc := self beginPaint: hwnd paintStructure: ps.

						self getClientRect: hwnd into: rect.
						self drawOn: hdc bounds: rect.
						self endPaint: hwnd paintStructure: ps.
						ps free.
						rect free.
						^0	].
	msgType @= Win32 WM_DESTROY
		ifTrue: [	{{<user ExternalProxy PostQuitMessage> arg: 0}}.
						^0 ].
	result := def APICallValue: hwnd value: msgType value: wParam value: lParam result: ExternalProxy new.
	^result! !

