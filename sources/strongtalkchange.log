! (Delta mirrorFor: #CodeView) methodsFor: 'private' !
buildClosureFor: expr <Str> ifFail: blk <[^X def]> ^ <[] | X>

	| result <[]> |
	result := Smalltalk
		blockToEvaluateFor: expr
		receiver: self receiver
		ifError: [ :err <Str> :pos <Int> |
						^blk value ].
	^[ result ensure: self evalBlock ]
! !

