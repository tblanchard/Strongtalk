        sends isEmpty
            ifTrue: [primary]
            ifFalse: [
                 sends first
                    inject: primary
                    into: [ :target <Expression>  :msg <DeltaMessage>  |
                        initialSend :=
                            self node: (DeltaNormalSend new to: target send: msg) beginNode: target endNode: msg
