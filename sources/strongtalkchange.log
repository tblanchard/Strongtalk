! (Delta mirrorFor: #ToggleButton) methodsFor: 'restricted-to session' !
isFocus: f <Boolean>

	super isFocus: f.
	(f not and: [ self isGrabbing ])
		ifTrue: [ self releaseGrab ].
	self invalidate.! !

