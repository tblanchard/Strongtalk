! (Delta mirrorFor: #VisualWrapper) methodsFor: 'accessing' !
part ^<Visual>

	^part! !

"December 10, 2001 -> 14:2:21"!

! (Delta mirrorFor: #VisualWrapper) methodsFor: 'accessing' !
part: p <Visual>

	part == p
		ifTrue: [ ^self ].
	part notNil
		ifTrue: [	self changing.
						part noParent ].
	part := p.
	p parent: self id: 1.! !

"December 10, 2001 -> 14:2:21"!

! (Delta mirrorFor: #VisualWrapper) methodsFor: 'accessing' !
partAt: childId <Int> ^<Visual>

	self assert: [ childId = 0 ].
	^self part! !

"December 10, 2001 -> 14:2:21"!

! (Delta mirrorFor: #VisualWrapper) methodsFor: 'accessing' !
removePart ^<Visual>
	"Detach and return the part"
	
	| p <Visual> |
	self layoutStatus = Visual valid
		ifTrue: [ self changing ].
	p := self part.
	p noParent.
	part := nil.
	^p! !

