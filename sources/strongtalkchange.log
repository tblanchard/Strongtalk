		with: (g1 := Glue xRigid: 100) with: (g2 := Glue xStretchy) with: (g3 := Glue xStretchy)
			with: (g4 := Glue yRigid: 10)).
cm parent: cm id: 1.
	Transcript show: 'natural: '; print: cm natural; cr;
			show: 'min: '; print: cm min; cr;
			show: 'max: '; print: cm max; cr.
	cm allocation: (0@-10 corner: 100@0) at: 0@0.
	Transcript show: 'g1: '; print: g1; print: g1 allocation; cr;
			show: 'g2: '; print: g2; print: g2 allocation; cr;
