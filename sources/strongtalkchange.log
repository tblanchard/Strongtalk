! (Delta mirrorFor: #ClassHierarchyOutliner) methodsFor: 'private' !
computeSubclasses 

	self showAnonymousInvocations
		ifTrue: [	self subclasses: self mirror directSubclasses ]
		ifFalse: [	self subclasses: self mirror directSubclassesSkipAnonymous ]
! !

