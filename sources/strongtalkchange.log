! (Delta mirrorFor: #OutlinerApp) methodsFor: 'control' !
closeChildrenAllLevels

	self childrenDo: [ :o <OutlinerApp> | 
		o open: false.
		o closeChildrenAllLevels ]
! !

"December 10, 2001 -> 14:7:4"!

! (Delta mirrorFor: #OutlinerApp) methodsFor: 'control' !
closeChildrenOneLevel

	self childrenDo: [ :o <OutlinerApp> | 
		o open: false ]! !

"December 10, 2001 -> 14:7:4"!

! (Delta mirrorFor: #OutlinerApp) methodsFor: 'control' !
