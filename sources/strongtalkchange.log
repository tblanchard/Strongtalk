! (Delta mirrorFor: #DeltaBlockApplication) classSide methodsFor: 'Unclassified' !
blokType: n <Int > ^ <DeltaGeneric>
    ^Delta at: (self blokName: n)
           ifAbsent:[self createBlokType: n].! !

