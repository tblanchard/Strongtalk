! (Delta mirrorFor: #LinkedList) methodsFor: 'accessing' !
removeFirst ^<L>

	| link <L> |
	self isEmpty
		ifTrue: [ self error: 'Empty LinkedList' ].
	link := self first.
	self first: (link nextLinkIfFail: 
		[	self removeAll.
			^link	]).
	^link! !

"December 10, 2001 -> 14:1:52"!

! (Delta mirrorFor: #LinkedList) methodsFor: 'accessing' !
removeLast ^<L>

	| link <L> final <L> next <L> |
	self isEmpty
		ifTrue: [ self error: 'Empty LinkedList' ].
	final := self last.
	link := self first.
	link == final
		ifTrue: [	self removeAll.
						^final	].
	[	next := link nextLink.
		next == final
		] whileFalse: [ link := next ].
	link noNextLink.
	self last: link.
	^final! !

