		;	show: 'Test Dead Code'
		;	cr.

    self testDeadCode1.
    self testDeadCode2.! !

"December 10, 2001 -> 14:28:47"!

! (Delta mirrorFor: #VMSuite) methodsFor: 'test code' !
testDeadCode1
    "use perform to prevent tests from being inlined"
    self perform: #dead1.
    self perform: #dead2.
    self perform: #dead3.
    self perform: #dead4.
    self perform: #dead5.
    self perform: #dead6.
    self perform: #dead7.
    self perform: #dead8.
    self perform: #dead9.
    self perform: #dead10.
    self perform: #dead11.
    self perform: #dead12.! !

"December 10, 2001 -> 14:28:47"!

! (Delta mirrorFor: #VMSuite) methodsFor: 'test code' !
testDeadCode2
    " with inlining"
    self  dead1.
    self  dead2.
    self  dead3.
    self  dead4.
    self  dead5.
    self  dead6.
    self  dead7.
    self  dead8.
    self  dead9.
    self  dead10.
    self  dead11.
    self  dead12.
! !

