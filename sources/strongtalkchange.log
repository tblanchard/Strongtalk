				promptYesNoCancel: 'The system has been changed.  Save system before exiting? (Quitting without saving will lose the changes you made)'
				title: 'Quit'
				type: #exclamation
				default: 3
				action: [ :ok <Boolean | Nil> |
								ok = nil
									ifFalse: [	ok
														ifTrue: [ Dumper saveSystem ]
														ifFalse: [ SourceHandler restoreBackup ].
													self doClose: toClose		]
								]! !

