! (Delta mirrorFor: #Integer) methodsFor: 'operations' !
gcd: other <Integer> ^<Integer>
	"greatest common divisor"

	| myabs <Int> otherabs <Int> lower <Int> higher <Int> |
	myabs := self abs.
	otherabs := other abs.

	myabs < otherabs
		ifTrue: [	lower := myabs.
						higher := otherabs.	]
		ifFalse: [	lower := otherabs.
						higher := myabs.		].
	[ lower == 0 ]
		whileFalse:
			[	| oldHigher <Int> |
				oldHigher := higher.
				higher := lower.
				lower := oldHigher \\ lower.	].
	^higher! !

