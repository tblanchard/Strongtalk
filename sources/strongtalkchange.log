! (Delta mirrorFor: #CharacterOutput) methodsFor: 'utility' !
cr

	self nextPut: Character cr! !

"December 10, 2001 -> 14:29:21"!

! (Delta mirrorFor: #CharacterOutput) methodsFor: 'utility' !
crTab

	self crTab: 1! !

"December 10, 2001 -> 14:29:21"!

! (Delta mirrorFor: #CharacterOutput) methodsFor: 'utility' !
