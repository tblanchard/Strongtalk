! (Delta mirrorFor: #Collection) methodsFor: 'accessing' !
hash ^<Int>

	| count <Int> |
	count := 0.
	^self inject: 0 into:
		[ :hash <Int> :el <E> |
			| newHash <Int> |
			newHash := hash bitXor: el hash.
			count := count + 1.
			count > 2
				ifTrue: [ ^newHash ].
			newHash ]! !

