! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
go: distance <Int> on: hdc <ExternalProxy>

	| a <Int> |
	a := angle.
	a = 0
		ifTrue: [ yPos := yPos - distance ]
		ifFalse: [ a = 90 ifTrue: [ xPos := xPos + distance ]
							ifFalse: [ a = 180 ifTrue: [ yPos := yPos + distance ]
											ifFalse: [ "must by 270" xPos := xPos - distance ] ]].
	self lineToX: xPos y: yPos on: hdc! !

