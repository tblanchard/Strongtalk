! (Delta mirrorFor: #MMBenchmark) methodsFor: 'private' !
initmatrix 
	| m temp |
	m := self mmMatrix.
	1 to: Rowsize do: [:i | 1 to: Rowsize do: 
			[:j | 
			temp := self newValue.
			(m at: i)
				at: j put: temp - (temp / 120 * 120) - 60]].
	^m! !

