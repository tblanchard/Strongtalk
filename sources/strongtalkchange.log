! (Delta mirrorFor: #DefWithMsgSourceHandler) methodsFor: 'Unclassified' !
selectorsDo: blk <[Symbol]>

	self indexDict keysDo: [ :s <Symbol> | s first = $# ifFalse: [blk value: s] ]! !

