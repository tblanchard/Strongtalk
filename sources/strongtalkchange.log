	self 
		launchSingleLineTextDialogWithPainter: Painter default
		title: 'Filter on comments containing the string (wildcards allowed): '
		caption: 'Set Filter' 
		default: ''
		action: [ :s <Str> | self filterOnCommentsContaining: s ]! !

