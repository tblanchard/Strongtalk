! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
registerWinClassFor: hInstance <ExternalProxy> ^<WNDCLASS>

	|	wcls <WNDCLASS>
		icon <ExternalProxy>
		cursor <ExternalProxy>
		back <ExternalProxy>
		proc <APICallBack> |
	wcls := WNDCLASS new allocateZeroed.

	icon := {{<user ExternalProxy LoadIconA> arg: 0 arg: Win32 IDI_APPLICATION}}.
	cursor := {{<user ExternalProxy LoadCursorA> arg: 0 arg: Win32 IDC_ARROW}}.
	back := {{<gdi ExternalProxy GetStockObject> arg: Win32 WHITE_BRUSH}}.

	def := {{primitiveDefWindowProc: ExternalProxy new ifFail: [:err| self error: err]}}.
	proc := APICallBack
		register:
			[ :hwnd <ExternalData> :msg <SmallInteger> :wParam <ExternalData> :lParam <ExternalData> |

				self wndProc: hwnd message: msg wParam: wParam lParam: lParam ]
		parameters: (OrderedCollection[Class]
								with: ExternalProxy with: SmallInteger with: ExternalProxy with: ExternalProxy).

	wcls style: (Win32 CS_HREDRAW bitOr: Win32 CS_VREDRAW);
			lpfnWndProc: proc;
			cbClsExtra: 0; 
			cbWndExtra: 0;
			hInstance: hInstance;
			hIcon: icon;
			hCursor: cursor;
			hbrBackground: back;
			lpszMenuName: Win32 NULL;
			lpszClassName: self winClassName.

	{{<user ExternalProxy RegisterClassA> class: wcls}} asBoolean
		ifFalse: [ self error: 'Cannot register window class' ].

	^wcls! !

