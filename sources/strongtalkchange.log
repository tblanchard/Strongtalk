! (Delta mirrorFor: #CharacterInput) methodsFor: 'accessing' !
upTo: o <Object> ^<Str>

	| con <SeqCltn[Character]> |
	con := super upTo: o.
	"%todo use Str below when have first class protocols"
	^con Str
		ifTrue: [ guaranteed <Str> con ]
		ifFalse: [ String withAll: con ]! !

