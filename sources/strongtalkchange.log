                                           superprotocol: (self superclass privateProtocol forcedSubstitute: self myLocalSubstitution)
                                           delta: d
                                           branded: self branded
                                           subtype: self subtype.
self relevantTypeVars do:[: rtv <TypeVar> | p addRelevantTypeVar: rtv].
^p.! !

