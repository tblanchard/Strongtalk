! (Delta mirrorFor: #OutlinerApp) methodsFor: 'accessing child/parent' !
addChild: o <OutlinerApp> ^ <OutlinerApp>

	o hasParent
		ifTrue: [ self error: 'Attempt to set parent twice' ]
		ifFalse: [ 	self children add: o.
						o parent: self ].
	^o! !

