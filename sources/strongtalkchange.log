	"The file type (on most platforms this is the part after the $. at the end)"

	| indices <SeqCltn[Int]> |
	indices := self name indicesOfSubCollection: '.'.
	indices isEmpty
		ifTrue: [ ^'' ].
	^self name
			copyFrom: indices last + 1
			to: self name size! !

