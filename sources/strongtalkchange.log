! (Delta mirrorFor: #Random) methodsFor: 'private' !
actualNextUsingFloatValues ^<Float>

	| temp <FloatValue> mod <FloatValue> |

	mod := self modulus asFloatValue.
	temp := self multiplier asFloatValue * self seed asFloatValue.
	temp := temp - (mod * (temp/mod) asFloat truncated asFloatValue).
	self seed: temp asFloat.
	temp := temp / mod.
	^temp asFloat! !

