! (Delta mirrorFor: #CompositeVisual) methodsFor: 'debugging' !
dumpOn: strm <CharOutputStream> indent: level <Int>

	super dumpOn: strm indent: level.

	self do: [ :child <SUB> |
					child dumpOn: strm indent: level + 1.	].! !

