! (Delta mirrorFor: #SmallInteger) methodsFor: 'file out' !
fileOutOn:  d <Dumper>
    self >= 0 ifTrue: [
		d putByte: 48.
		d putInteger: self.
    ] ifFalse: [
		d putByte: 45.
		d putInteger: self abs.
    ]! !

