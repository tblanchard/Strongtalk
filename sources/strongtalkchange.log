	self win32Brush: self nullBrush.		"Don't fill interior"

	{{<gdi ExternalProxy Rectangle>
			hdc: self
			xLeft: (r left + offx) asInteger
			yTop: (r top + offy) asInteger
			xRight: (r right + offx) asInteger
