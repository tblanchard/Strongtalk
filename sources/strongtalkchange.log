! (Delta mirrorFor: #VMSuite) methodsFor: 'block tests' !
blockTest1
	| blk1 <[]> blk2 <[]>  i <Integer> b <Boolean> |
	blk1 := [ i := i - 1 ].
	blk2 := [ i := i - 2 ].	
	1000 timesRepeat: [ 
		i := 1000.
		b:= true.
		[ i > 0 ] whileTrue: [
			b 
				ifTrue: blk1 
				ifFalse: blk2.
			b := b not
		]
	]
! !

"December 10, 2001 -> 14:28:47"!

! (Delta mirrorFor: #VMSuite) methodsFor: 'block tests' !
blockTest2
	|  i <Integer> b <Boolean> blk <[]> |
	100 timesRepeat: [ 
		i := 1000.
		b:= true.
		[ i > 0 ] whileTrue: [
			blk := b 
				ifTrue: [ [ i := i - 1 ] ] 
				ifFalse: [ [ i := i - 2 ] ].
			blk value.
			b := b not
		]
	]! !

"December 10, 2001 -> 14:28:47"!

! (Delta mirrorFor: #VMSuite) methodsFor: 'block tests' !
blockTest3
	|  i <Integer> b <Boolean> blk <[]> |
	100 timesRepeat: [ 
		i := 1000.
		b:= true.
		[ i > 0 ] whileTrue: [
			b 
				ifTrue: [  blk := [ i := i - 1 ] ] 
				ifFalse: [ blk := [ i := i - 2 ] ].
			blk value.
			b := b not
		]
	]! !

