! (Delta mirrorFor: #DeltaTypeErrorHandlerStack) methodsFor: 'Unclassified' !
definitionLocatorFor: node  <DeltaASTNode> ^ <DeltaLocator>

^self currentDefinition locatorFor: node.

! !

