trial: j 
	| k |
	kount := kount + 1.
	0 to: self typemax do: [:i | (piececount at: (class at: i))
			~= 0 ifTrue: [(self fitI: i J: j)
				ifTrue: 
					[k := self placeI: i J: j.
					((self trial: k)
						or: [k = 0])
						ifTrue: [^true]
						ifFalse: [self removeI: i J: j]]]].
	^false! !

