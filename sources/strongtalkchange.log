! (Delta mirrorFor: #RBObject) methodsFor: 'misc' !
append: packet head: queueHead
    | mouse link |
    packet link: NoWork.
    NoWork == queueHead ifTrue: [^packet].
    mouse := queueHead.
    [NoWork == (link := mouse link)]
        whileFalse: [mouse := link].
    mouse link: packet.
    ^queueHead
! !

