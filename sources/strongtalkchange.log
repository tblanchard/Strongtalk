! (Delta mirrorFor: #ExternalOutputStream) methodsFor: 'control' !
flush
	
	self dirty
		ifTrue: [	self bufferNumElements > 0
					ifTrue: [	self writeBuffer; updateBufferLocationAfterFlush. 	].
				self dirty: false.	].! !

