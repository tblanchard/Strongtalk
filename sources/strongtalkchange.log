loadHTMLIfFail: fail <[^X def]>  ^<HTMLNode | X>

	self assert: [ self isRelative not ].

	"We are absolute, so just use a bogus context, since it will be ignored"
	^self loadHTMLInContext: self ifFail: fail! !

