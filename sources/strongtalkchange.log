! (Delta mirrorFor: #ClassHierarchyOutliner) methodsFor: 'private' !
findSubclassMatching: pattern <Str>

	| list <SeqCltn[AbstractClassMirror]> subclasses <SeqCltn[Class]> |
	
	self mirror reflectee == Object					"Optimize the common case"
		ifTrue: [		subclasses := OrderedCollection[Class] new: Smalltalk size.
							Smalltalk classesDo: [ :c <Class> | subclasses add: c ] ]
		ifFalse: [	subclasses := self mirror subclassesSkipAnonymous collect: [ :e | e reflectee ] ].

	"Search for classes matching pattern"
	list := OrderedCollection[AbstractClassMirror] new.
	subclasses do: [ :c <Class> |
		(pattern platformMatch: c name)
			ifTrue: [	list add: c ] ].

	"If none found append * to pattern and try again"
	list isEmpty
		ifTrue: [	| newPattern <Str> |
						newPattern := pattern, (String with: Platform multipleMatchWildcardCharacter).
						subclasses do: [ :c <Class> |
							(newPattern platformMatch: c name) 
								ifTrue: [	list add: c ] ] ].

	"If still none found give up"
	list isEmpty
		ifTrue: [	^self findSubclass: true ].

	"If single element found select it"
	list size = 1
		ifTrue: [	^self expandAndSetFocusForClass: (AbstractClassMirror on: (list at: 1)) ].

	"Otherwise query user for selection"
	list := list asSortedCollection: [ :c1<Class> :c2 <Class> | c1 name <= c2 name ].
	self 
		launchListDialogWithPainter: self classPainter 
		title: 'Select subclass of ', self mirror name
		contents: (list collect: [ :e <AbstractClassMirror> | e name ])
		multi: false
		action: [ :sels <Cltn[Int]> | self expandAndSetFocusForClass: (AbstractClassMirror on: (list at: sels anElement)) ].		"We use a single selection listbox so we have exactly one element"
 
! !

