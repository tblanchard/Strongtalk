! (Delta mirrorFor: #Window) methodsFor: 'private' !
globalFromLocalPosition: p <Point> ^<Point>

	| wp <POINT> result <Point> |
	wp := POINT new allocate.
	wp x: p x; y: p y.
	{{<user ExternalProxy ClientToScreen>
			handle: self win32Handle
			point: wp
	}} asBoolean
		ifFalse: [ Win32 handleError ].
	result := wp x @ wp y.
	wp free.
	^result! !

