! (Delta mirrorFor: #OutlinerApp) methodsFor: 'control' !
openChildrenOneLevel

	self body.												"Force body to be built, otherwise children may not be computed"
	self childrenDo: [ :o <OutlinerApp> | 
		o open: true ].
	self open: true.! !

