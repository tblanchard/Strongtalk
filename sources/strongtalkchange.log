! (Delta mirrorFor: #DefWithMsgSourceHandler) methodsFor: 'Unclassified' !
tagsForSelector: sel <Symbol>  ^ <OrdCltn[Str]>

	| list <OrdCltn[Str]> |
	list := self attributeAt: sel.
	list size < 3 ifTrue: [ self shouldNotHappen ].
	^list copyFrom: 4 to: list size.! !

