! (Delta mirrorFor: #DeltaHCode) methodsFor: 'Unclassified' !
addWord: w
    "Private. Adds w aligned to the code.
    Should rethink this - byte ordering dependent."
    | t |
    self assert: [w isInteger].
    self align.
    "little endian machine"
    t := w.
    4 timesRepeat: [
        self addByte: t \\ 256.
        t := t // 256
    ]! !

