	tbl := self table.
	tbl == nil
		ifTrue: [ ^self ].

	newtbl := self newTableWithSize: tbl size.
	1 to: tbl size do:
		[ :index <Int> |
			self atIndex: index
					inTable: tbl
					occupiedSlotDo:
						[ :val <A> |
							newtbl at: index put: (self elementForCopy: val)	]
					emptySlotDo: [ ]
					deletedSlotDo:
						[	newtbl at: index put: newtbl		]
		].
	self setTable: newtbl! !

