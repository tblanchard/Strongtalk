! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
drawHilbertOn: hdc <ExternalData> bounds: rect <RECT>

	| text <ExternalProxy> size <Int> time <Int> |
	angle := 90.
	size := rect right max: rect bottom.
	xPos := 0.
	yPos := 0.
	self moveToX: 0 y: 0 on: hdc.
	time := [ self hilbert: 6 side: 5 on: hdc. {{<gdi ExternalProxy GdiFlush> flush}} ] userTime.
	self drawText: time printString on: hdc bounds: rect.
! !

