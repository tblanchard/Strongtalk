! (Delta mirrorFor: #ScrollState) methodsFor: 'control' !
lineForward
	"scroll forward (down or right) one line (one grid position), or 5,
	  whichever is more."


	self adjustedScrollPosition: (self adjustPosForward: self scrollPosition + 5)! !

