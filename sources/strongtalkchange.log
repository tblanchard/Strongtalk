dead1

  true ifTrue: [ ^ 1].
  self some dead code! !

"December 10, 2001 -> 14:28:46"!

! (Delta mirrorFor: #VMSuite) methodsFor: 'test code' !
dead10

 ( [^ 1] value ) or: [  self some dead code. ]! !

