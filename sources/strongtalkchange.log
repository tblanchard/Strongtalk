! (Delta mirrorFor: #TypedCodeView) methodsFor: 'menus' !
acceptMenu ^<Menu>

	^super acceptMenu
		addSeparator;
		addAll: self typecheckingMenu removeAll! !

"December 10, 2001 -> 14:22:37"!

! (Delta mirrorFor: #TypedCodeView) methodsFor: 'menus' !
menuBar ^<Menu>

	^super menuBar add: self typecheckingMenu! !

