! (Delta mirrorFor: #HTMLTag) methodsFor: 'printing' !
printOn: strm <CharOutputStream>

	strm put: $<.
	self isEnd
		ifTrue: [ strm put: $/ ].
	strm putAll: self name.
	self attributes notNil
		ifTrue: [ self attributes do:
						[ :attr <Tuple[Str,Str]> |
							strm space.
							strm putAll: attr at1.
							attr at2 isNil
								ifFalse: [ strm put: $=; print: attr at2 ]
						].
					].
	strm put: $>.! !

