	^true! !

"December 10, 2001 -> 14:5:22"!

! (Delta mirrorFor: #HTMLFrame) methodsFor: 'event handling' !
mouseEvent: type <Symbol> at: loc <Point>  event: ev <UIEvent> ^<Boolean>

	(super mouseEvent: type at: loc event: ev)
		ifTrue: [ ^true ].
	
	self inPresentationMode
		ifFalse: [ ^false ].
	
	"We are in presentation mode, and no child wants the event"
	type = #primaryButtonUp
		ifTrue: [	self htmlView gotoNextPresentationPage.
						^true ].
	type = #secondaryButtonUp
		ifTrue: [	self htmlView gotoPrevPresentationPage.
						^true ].
	^false! !

