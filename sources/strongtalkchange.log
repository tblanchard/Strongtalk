! (Delta mirrorFor: #FilePath) classSide methodsFor: 'testing' !
test

	| f <FilePath> f2 <FilePath> |

	f := FilePath for: 'tmpDir'.
	[ f exists not ] verify.

	f createDirectoryIfFail: [ :err <Symbol> | Win32 handleError ].
	[ f exists ] verify.
	[ f isDirectory ] verify.
	[ f isWriteable ] verify.

	f2 := f , (FilePath for: 'sub').
	[ f2 exists not ] verify.

	f2 createDirectoryIfFail: [ :err <Symbol> | Win32 handleError ].
	[ f2 exists ] verify.
	[ f isDirectory ] verify.
	[ f isWriteable ] verify.

	[ (self tryToDeleteTestDir: f) not ] verify.
	[ self tryToDeleteTestDir: f2 ] verify.
	[ self tryToDeleteTestDir: f ] verify.

	[ f2 exists not ] verify.
	[ f exists not ] verify.
! !

