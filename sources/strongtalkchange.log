! (Delta mirrorFor: #Font) classSide methodsFor: 'instance creation' !
default ^<Font>

	DefaultFont isNil
		ifTrue: [ DefaultFont := self forSpec:
						(FontSpec new
							typeface: 'MS Sans Serif';
							points: 10;
							boldness: 0.0
							) ].
	^DefaultFont! !

