! (Delta mirrorFor: #DefinitionReader) methodsFor: 'Unclassified' !
category ^ <Str>
	^category isNil 
		ifTrue: ['Unclassified']
		ifFalse: [category]
! !

"December 10, 2001 -> 14:16:34"!

! (Delta mirrorFor: #DefinitionReader) methodsFor: 'Unclassified' !
category: c <Str>
	category := c.
	('*private*' match: c)
		ifTrue: [ visibility := #private ]
		ifFalse: [ visibility := #public ]
! !

