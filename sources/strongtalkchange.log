wordAt: pos put: w
    "This should be rethought - byte ordering dependency"
    | p t |
    "little endian machine"
    p := pos.
    t := w.
    4 timesRepeat: [
        self byteAt: p put: t \\ 256.
        p := p + 1.
        t := t // 256
    ]! !

