! (Delta mirrorFor: #Mandelbrot) methodsFor: 'computation' !
iterateAt_re: re <Float> im: im <Float> steps: n <Int> ^<Int>
	|
	c_re		<FloatValue>
	c_im		<FloatValue>
	z_re		<FloatValue>
	z_im	<FloatValue>
	d_re		<FloatValue>
	d_im	<FloatValue>
	two		<FloatValue>
	four		<FloatValue>
	i
	end <Int>
	|
	end := n - 1.
	i := 0.
	z_re := re asFloatValue.
	c_re := z_re.
	z_im  := im asFloatValue.
	c_im := z_im.
	d_re := z_re squared.
	d_im := z_im squared.

	two := 2.0 asFloatValue.
	four := 4.0 asFloatValue.

	[ i < end and: [ d_re + d_im <= four ] ] whileTrue: [
		z_im := two * z_re * z_im + c_im.
		z_re := d_re - d_im + c_re.
		d_re := z_re squared.
		d_im := z_im squared.
		i := i + 1
	].
	^ i
! !

