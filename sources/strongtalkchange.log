! (Delta mirrorFor: #InliningDatabase) classSide methodsFor: 'file in' !
compileClassPath: cp <FilePath>
	(cp, (FilePattern for: '*')) pathsDo: [ :fp <FilePath> | | base <String> |
		base := fp elements last pattern.
		('*.txt' match: base) ifTrue: [
			self compileFile: fp
		]
	]! !

