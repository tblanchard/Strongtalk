! (Delta mirrorFor: #ReadString) methodsFor: 'copying' !
, other <Str>	^<String>

	|	copy <String>
		sz <Int>
		osz <Int> |
	sz := self size.
	osz := other size.
	copy := String new: sz + osz.
	1 to: sz do:
		[ :i <Int> |
			copy at: i put: (self at: i) ].
	sz + 1 to: sz + osz do:
		[ :i <Int> |
			copy at: i put: (other at: i - sz) ].
	^copy! !

