! (Delta mirrorFor: #CodeView) methodsFor: 'control' !
doIt

	(self buildClosureIfFail: [^self]) fork
! !

"December 10, 2001 -> 14:4:31"!

! (Delta mirrorFor: #CodeView) methodsFor: 'control' !
fileItIn

	[ self selectionString readStream fileIn ] fork! !

"December 10, 2001 -> 14:4:31"!

! (Delta mirrorFor: #CodeView) methodsFor: 'control' !
inspectIt

	(Inspector on: (self computeValueIfFail: [^self])) launch
! !

