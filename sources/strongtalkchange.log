	do:	[: tf <TypeFormal> | 
			astIndex := (loc := TypeArgumentLocator 	onTypeArgument: tf name
																					ofDefinition: self) indexFor: node.
			astIndex ~= 0 ifTrue:[^loc astIndex: astIndex].
			].

"

! !

