test3

	| cm rows g1 g2 g3 g4 |
	rows := OrderedCollection new.
	1000 timesRepeat: [ rows add: (RowManager staticWithAll: (Array
		with: (g1 := Glue xRigid: 100) with: (g2 := Glue xStretchy) with: (g3 := Glue xStretchy)
			with: (g4 := Glue yRigid: 10))) ].
	cm := ColumnManager staticWithAll: rows.

Transcript show: 'Time: '; print: [
	| nat |
	cm parent: cm id: 1.
	nat := cm natural.
	cm allocation: nat at: 0@0	] time! !

