! (Delta mirrorFor: #Font) methodsFor: 'private' !
flush

	medium := nil.
	win32Font := nil.		"We need to do this in case we need to switch fonts between the
										screen and printer"
	metrics notNil
		ifTrue: [	metrics free.
						metrics := nil.	].! !

