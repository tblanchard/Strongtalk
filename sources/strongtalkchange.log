				show: time printString
			;	show: ' ms, * '
			;	show: dFactor printString
			;	show: ' = '
			;	show: dTime printString
			;	show: ' ms D, * '
			;	show: pFactor printString
			;	show: ' = '
			;	show: pTime printString
			;	show: ' ms P.'
	].
	Transcript cr.! !

