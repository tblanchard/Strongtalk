! (Delta mirrorFor: #DeltaHCodeGenerator) methodsFor: 'Unclassified' !
and
    "Answers fixup address."
    longJumps
        ifTrue: [code byte: (HCodeTable at: #andL) word: 0]
        ifFalse: [code byte: (HCodeTable at: #andS) byte: 0].
    ^ code size! !

