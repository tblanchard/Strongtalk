! (Delta mirrorFor: #Queue) methodsFor: 'private' !
linkAt: index <Int> ^<DoubleLink[E]>

	| i <Int> next <DoubleLink[E]> |
	i := 1.
	next := self head.
	[ i < index ]
		whileTrue: [ next := next next.
								i := i + 1. ].
	^next! !

