aligningFor: builder <HTMLBuilder> do: blk <[]>
	"evaluate blk with any alignment attributes in effect"

	| old <Symbol> new <Symbol> |
	new := self alignment.
	old := builder alignment.
	(new isNil or: [ new = old ])
