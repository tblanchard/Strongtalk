promptForSubclassFilter

	self 
		launchSingleLineTextDialogWithPainter: Painter default
		title: 'Show subhierarchy'
		caption: 'Show only subclass hierarchy for class:'
		default: ''
		action: [ :s <Str> |
			| cl <Object> |
			cl := Smalltalk at: s ifAbsent: [ nil ].
			(cl notNil and: [ cl isKindOf: Class ]) 
				ifTrue: [
					| cm <ClassMirror> |
					cm := ClassMirror on: cl.
					self filter: [ :acm <AbstractClassMirror> |
											self class: acm reflectee isClassKindOf: cm reflectee ]
				 ]	]! !

