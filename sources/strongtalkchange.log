! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
errorSymbols
	| col str result |
	result := OrderedCollection new.
	col := self getAttribute: #error ifAbsent: [^result].
	col do: [ :v | result add: v value asString ].
	^result! !

