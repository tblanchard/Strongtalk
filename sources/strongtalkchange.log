! (Delta mirrorFor: #PressHandler) classSide methodsFor: 'instance creation' !
forButton: but <Symbol>
onPress: p <[^Object]>
onAction: r <[^Object]>
onCancel: c <[^Object]>
 ^<Instance>
	"Where but is #primary, #secondary, or #middle"

	^(super new)
		onPress: p;
		onAction: r;
		onCancel: c;
		button: but! !

