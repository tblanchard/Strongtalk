! (Delta mirrorFor: #ReadString) methodsFor: 'printing' !
printOn: strm <CharOutputStream>

	strm nextPut: $'.
	1 to: self size do:
		[ :i <Int> |
			| c <Character> |
			strm nextPut: (c := self at: i).
			c = $' ifTrue: [ strm nextPut: c ].	].
	strm nextPut: $'.! !

