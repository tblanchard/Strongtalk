! (Delta mirrorFor: #Set) classSide methodsFor: 'testing' !
includePerformanceTest

	| d <Set[Symbol]>  x <Symbol>  |
	d := Set[Symbol] new.
	500000 timesRepeat:
		[	x := d include: #hello	].
	self assert: [ x = #hello ].! !

