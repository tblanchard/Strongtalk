! (Delta mirrorFor: #ReadString) methodsFor: 'searching' !
indexOfStr: sub <Str>
startingAt: index <Int>
caseSensitive: caseSens <Boolean>
ifAbsent: f <[^X def]>
^<Int | X>

	index to: (self size - sub size) + 1 do:
		[ :i <Int> |
			(self collection: sub matchesElementsAt: i caseSensitive: caseSens)
				ifTrue: [ ^i ]		].
	^f value! !

