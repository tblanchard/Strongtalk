! (Delta mirrorFor: #Viewport) classSide methodsFor: 'instance creation' !
for: v <Visual> ^<Instance>

	^self new client: v! !

"December 10, 2001 -> 14:23:56"!

! (Delta mirrorFor: #Viewport) methodsFor: 'initialization' !
constrainX ^<Boolean>

	^constrainX! !

"December 10, 2001 -> 14:23:56"!

! (Delta mirrorFor: #Viewport) methodsFor: 'initialization' !
constrainX: v <Boolean>

	constrainX := v! !

"December 10, 2001 -> 14:23:56"!

! (Delta mirrorFor: #Viewport) methodsFor: 'initialization' !
constrainY ^<Boolean>

	^constrainY! !

