! (Delta mirrorFor: #OutputStreamView) methodsFor: 'private' !
saveAs: f <FilePath> onSuccess: blk <[]>

	| strm <CharOutputStream> |
	strm := f charOutputStream.
	[ self textView model do: [ :cg <CharacterGlyph> | strm put: cg character ] ]
		ensure: [ strm close ].
	blk value
