! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
hilbert: n <Int> side: s <Int> on: hdc <ExternalProxy>

	| a <Int> m <Int> |
	n = 0 ifTrue: [ ^self turn: 180 ].
	n > 0 ifTrue: [	a := 90.
							m := n - 1 ]
			ifFalse: [	a := -90.
							m := n + 1 ].
	self	turn: a;
			hilbert: 0 - m side: s on: hdc;
			turn: a;
			go: s on: hdc;
			hilbert: m side: s on: hdc;
			turn: 0 - a;
			go: s on: hdc;
			turn: 0 - a;
			hilbert: m side: s on: hdc;
			go: s on: hdc;
			turn: a;
			hilbert: 0 - m side: s on: hdc;
			turn: a.! !

