! (Delta mirrorFor: #ClassCritical) classSide methodsFor: 'restricted' !
monitor ^<Semaphore>

	"Check before entering critical region as an optimization"
	Monitor == nil
		ifTrue: [	Processor uninterruptablyDo:
							[ Monitor == nil
								ifTrue: [ Monitor := Semaphore forMutualExclusion ].
							].
					 ].
	^Monitor! !

