! (Delta mirrorFor: #CommentOutliner) methodsFor: 'control' !
removeComment

	| removeBlk <[]> |
	removeBlk := [ 
		self comment: ''. 
		self updateClosedHeader. 
		self updateBody.
		self open: false ].

	self codeView isNil 
		ifTrue: removeBlk
		ifFalse: [ self codeView closeRequest: removeBlk ]
! !

