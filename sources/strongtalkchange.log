	self flushText.
	id := {{<gdi ExternalProxy SaveDC> hdc: self}}.
	copy := self shallowCopy.
	blk value: copy.
	copy flushText.
	{{<gdi ExternalProxy RestoreDC> hdc: self id: id}} asBoolean
		ifFalse: [ self error: 'Error restoring device context' ].! !

