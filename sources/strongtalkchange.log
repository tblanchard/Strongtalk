! (Delta mirrorFor: #URL) methodsFor: 'accessing' !
absoluteURLInContext: context <URL>  ^<URL>

	self isRelative
		ifFalse: [ ^self ].
	^URL for: context pathBase,
			(self path first = $#
				ifTrue: [	self path ]
				ifFalse: [ '/',self path ]
			)! !

