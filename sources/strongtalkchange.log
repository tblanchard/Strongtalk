! (Delta mirrorFor: #PuzzleArray) methodsFor: 'iterating' !
do: aBlock  
	"Evaluate aBlock with each of the receiver's elements as the argument."

	| index length |
	index := -1.
	length := self size - 1.
	[(index := index + 1) <= length]
		whileTrue: [aBlock value: (self at: index)]! !

