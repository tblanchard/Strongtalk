	type = #info
		ifTrue: [ ^Win32 MB_ICONINFORMATION ].
	type = #stop
		ifTrue: [ ^Win32 MB_ICONSTOP ].
	type = #exclamation
		ifTrue: [ ^Win32 MB_ICONEXCLAMATION ].
	type = #question
