! (Delta mirrorFor: #DefWithMsgSourceHandler) methodsFor: 'Unclassified' !
selectorsFor: cat <Str> ^ <OrdCltn[Symbol]>

	| sels <Set[Symbol]> |
	sels := Set[Symbol] new.
	self selectorsDo: [ :sel <Symbol> | 
		(self categoryForSelector: sel) = cat ifTrue: [ 
			sels add: sel ] ].
	^sels
! !

