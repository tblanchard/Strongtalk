! (Delta mirrorFor: #Integer) methodsFor: 'iteration' !
to: stop <Int> do: f <[Int]> ^<Object>

	| v <Int> |
	v := self.
	[ v <= stop ]
		whileTrue: [	f value: v.
					v := v + 1  ].
	^nil! !

