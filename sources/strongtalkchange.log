	| col <Column[Visual]> label <Visual> pmh <PopUpMenuHandler> |
	col := Column[Visual] new.
	list do: [ :m <M> |
		label := self	 buildLabel: m name 
							painter: self labelPainter 
							action: [ (DefWithMsgOutliner[M] on: m) launch ].
