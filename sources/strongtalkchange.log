! (Delta mirrorFor: #HTMLView) methodsFor: 'private-forward' !
forwardURLs ^<OrdCltn[URL]>

	forwardURLs isNil
		ifTrue: [ forwardURLs := OrderedCollection[URL] new. ].
	^forwardURLs! !

"June 28, 2002 -> 16:22:34"!

! (Delta mirrorFor: #HTMLView) methodsFor: 'private' !
getNextURLOrIfAbsent: failBlk <[^X def]>  ^<URL | X>

	^self forwardURLs isNil
		ifFalse: [ self forwardURLs pop ]
		ifTrue: [ failBlk value ]! !

"June 28, 2002 -> 16:22:34"!

! (Delta mirrorFor: #HTMLView) methodsFor: 'control' !
back

	| newlen <Int> |
	self hasHistory
		ifFalse: [ ^self ].
	newlen := self history size - 1.
	self model: self history last.
	"setting the model put the link back on the history, so we
	  have to take it back off again"
	[ self history size > newlen ]
		whileTrue: [ self history removeLast. ].
	self checkBack! !

