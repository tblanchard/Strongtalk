! (Delta mirrorFor: #DeltaRewriter) methodsFor: 'Unclassified' !
dllCallNode: node
    self assert: [node isDLLCallNode].
    result :=
        DeltaDLLCall new
            to: node dll
            send: (self rewrite: node msg)
            called: node function
            return: node proxy
			async: node async! !

