! (Delta mirrorFor: #Mandelbrot) methodsFor: 'computation' !
slowIterateAt_re: re <Float> im: im <Float> steps: n <Int> ^<Int>
	|
	c_re
	c_im		
	z_re		
	z_im	
	d_re		
	d_im	
	two		
	four	
	i
	end <Int>
	|
	end := n - 1.
	i := 0.
	z_re := c_re := re.
	z_im := c_im := im.
	d_re := z_re * z_re.
	d_im := z_im * z_im.

	two := 2.0.
	four := 4.0.

	[ i < end and: [ d_re + d_im <= four ] ] whileTrue: [
		z_im := two * z_re * z_im + c_im.
		z_re := d_re - d_im + c_re.
		d_re := z_re * z_re.
		d_im := z_im * z_im.
		i := i + 1
	].
	^ i
! !

