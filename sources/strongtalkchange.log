! (Delta mirrorFor: #Table) methodsFor: 'private' !
colEqualizers ^<Array[Equalizer]>

	colEqualizers isNil
		ifTrue: [	colEqualizers := Array[Equalizer] new: self numCols.
						1 to: self numCols do:
