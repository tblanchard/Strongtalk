! (Delta mirrorFor: #DeltaHCodeGenerator) methodsFor: 'Unclassified' !
floatBinaryOp: f
	self popFloat.
	self assert: [ self floatStackIsEmpty not ].
	code float_binary_op_byte: self floatStackTopIndex byte: (self floatBinaryOpCodeFor: f)! !

