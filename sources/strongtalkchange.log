ifFirst: onFirst <[^X def]>
ifAbsent: onAbsent <[^Y def]>
^<L | X | Y>

	| havePred <Boolean> pred <L> |
	havePred := false.
	self do:
		[ :l <L> |
			l == link
				ifTrue: [	^havePred ifTrue: [ pred ] ifFalse: [ onFirst value ]  ]
				ifFalse: [	pred := l.
