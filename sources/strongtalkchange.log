! (Delta mirrorFor: #ScrollState) methodsFor: 'constants' !
arrowScrollDist ^<Int>
	"when clicking on the scroll down/up arrow on a scrollbar, this is the
	 number of pixels the scroll is considered to be)"
	 
	 ^10! !

"June 28, 2002 -> 15:20:56"!

! (Delta mirrorFor: #ScrollState) methodsFor: 'control' !
lineForward
	"scroll forward (down or right) one line (one grid position), or 5,
	  whichever is more."


	self adjustedScrollPosition: (self adjustPosForward: self scrollPosition + self arrowScrollDist)! !

"June 28, 2002 -> 15:20:56"!

! (Delta mirrorFor: #ScrollState) methodsFor: 'control' !
lineBack
	"scroll back (up or left) one line (one grid position)"


	self adjustedScrollPosition: (self adjustPosBack: self scrollPosition - self arrowScrollDist)! !

