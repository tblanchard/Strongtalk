	(self mirror messages includesKey: sel)
		ifTrue: [^self]
		ifFalse: [
			^(self typeInfo == (Type forClass: (Delta at: #Object)) typeOfInstances)
				ifTrue: blk
				ifFalse: [self typeInfo superprotocol basicLocator locationOfMethod: sel ifAbsent: blk]]! !

