! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
flagsDo: blk
    | f |
    f := self getAttribute: #flags ifAbsent: [ ^self ].
    f isSymbol ifTrue: [ ^blk value: f ].
    f do: [ :e | blk value: e value ]! !

