! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
needsLastDeltaFrame ^ <Boolean>
    | value <Boolean>  |
    value := true.
    self flagsDo: [ :name <Symbol> |
        name == #LastDeltaFrameNotNeeded	ifTrue: [ value := false ].
    ].
