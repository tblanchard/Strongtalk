	50 timesRepeat: [ 	| chars |
										chars := OrderedCollection new.
										100 timesRepeat: [ chars add: (Glue xRigid: 100) ].
										rows add: (RowManager holding: chars). ].
	cm := ColumnManager holding: rows.

Transcript show: 'Time: '; print: [
	| nat |
