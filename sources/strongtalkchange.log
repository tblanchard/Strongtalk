! (Delta mirrorFor: #Time) classSide methodsFor: 'inquiries' !
userMillisecondsToRun: f <[]> ^<Int>
	"return number of user cpu milliseconds to evaluate f"

	| t <Int> |
	t := self millisecondUserClockValue.
	f value.
	^self millisecondUserClockValue - t! !

