! (Delta mirrorFor: #Visual) methodsFor: 'restricted-to parent' !
noParent
	"Unparent the visual"

	parent isNil
		ifFalse: [	self detaching.
						self isNonLocal
							ifTrue: [ self parent addNonLocalCount: self nonLocalCount negated ].
						parent := nil.
						id := nil.	]! !

