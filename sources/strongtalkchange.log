												self canvas
														displayLineFrom: startx @ cury
													to: (self extent x - 1) @ cury.		].
								].
				self profiling
					ifTrue: [ Profiler stop ].
				].
] time; cr.
] ensure: [ pens do: [ :pen <HPEN> | pen release ] ].
	self canvas flush.
	self imageCritical: [ self visual invalidate ].
