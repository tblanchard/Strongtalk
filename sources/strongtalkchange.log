! (Delta mirrorFor: #DefWithMsgSourceHandler) methodsFor: 'Unclassified' !
addCategory: c <Str>

	(self categories includes: c) ifFalse: [
		self categories: (self categories addLast: c; yourself).
		self changed: #categories ]
! !

