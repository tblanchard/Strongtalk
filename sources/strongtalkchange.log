! (Delta mirrorFor: #Button) methodsFor: 'accessing' !
image: i <Image>

	self changing.
	image := i.
	"Make sure there is no text."
	label := nil.
	
	"update the style"
	buttonStyle := self buttonStyle externalBitOr: Win32 BS_BITMAP.
	
	win32Handle isNil
		ifFalse: [	natural := nil.
							self setWindowImage: i.  ].! !

