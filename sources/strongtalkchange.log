	count timesRepeat:  [
		self nextPut: Character cr; nextPut: Character tab	]! !

"December 10, 2001 -> 14:29:21"!

! (Delta mirrorFor: #CharacterOutput) methodsFor: 'utility' !
nextChunkPut: s <Str>

	| terminator <Character> |
	terminator := $!!.
	s do: [ :char <Character> |
		self nextPut: char.
		char = terminator 
			ifTrue: [ self nextPut: terminator ] ].
	self nextPut: terminator.! !

