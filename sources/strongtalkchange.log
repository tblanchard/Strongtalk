! (Delta mirrorFor: #Baseliner) methodsFor: 'private' !
adjust: rect <Rect> ^<Rect>
	"return the baselined version of rect"

	| left <Int> right <Int> top <Int> bottom <Int> |
	left := rect left.
	right := rect right.
	top := rect top.
	bottom := rect bottom.
	"subtractions are used below because left and top are negative"
	self ySide == #top
		ifTrue: [	bottom := bottom - top.
						top := 0.	].
	self ySide == #bottom
		ifTrue: [	top := top - bottom.
						bottom := 0.  ].
	self xSide == #left
		ifTrue: [	right := right - left.
						left := 0.	].
	self xSide == #right
		ifTrue: [	left := left - right.
						right := 0.  ].
	^Rectangle
		left: left right: right top: top bottom: bottom! !

