! (Delta mirrorFor: #ClassVarLocator) methodsFor: 'accessing' !
ast ^ <VarDecl>

self mirror classVariablesDo:	[:c <VarDecl> |
																c name = self varName
																	ifTrue:[^c]
															].
^self error: 'Missing class variable ', self varName, 
														' in ', self mirror name.
