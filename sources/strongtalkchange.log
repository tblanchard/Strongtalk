! (Delta mirrorFor: #DeltaMixinDerivationNode) methodsFor: 'Unclassified' !
mixinObj ^ <Mixin>

"Return the mixin I denote"

self deltaHack.

^self selector = #delta
    ifTrue:[(Mirror on: self klass classObj) mixin reflectee]
    ifFalse:[(Mirror on: self klass classObj) mixin reflectee].! !

