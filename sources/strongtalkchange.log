! (Delta mirrorFor: #ElementLI) methodsFor: 'building' !
buildFor: builder <HTMLBuilder>

	builder verticalWhitespace.
	builder indented: -15
		do: [	self addBulletGlyphTo: builder.
					builder indented: 15
						do: [	super buildFor: builder ]
				].
	builder breakLine.! !

"June 28, 2002 -> 15:30:23"!

! (Delta mirrorFor: #ElementP) methodsFor: 'building' !
buildFor: builder <HTMLBuilder>

	(builder atParagraphStart and: builder previousLineHadNoText)
		ifTrue: [ super buildFor: builder ]
		ifFalse: [	builder verticalWhitespace.
						self aligningFor: builder
							do: [	self for: builder withColorsFromAttributesDo:
											[	super buildFor: builder.
												builder breakLine. ].
									].	]
! !

"June 28, 2002 -> 15:30:24"!

! (Delta mirrorFor: #ElementP) methodsFor: 'building' !
buildFor: builder <HTMLBuilder>

	(builder atParagraphStart and: [builder previousLineHadNoText])
		ifTrue: [ super buildFor: builder ]
		ifFalse: [	builder verticalWhitespace.
						self aligningFor: builder
							do: [	self for: builder withColorsFromAttributesDo:
											[	super buildFor: builder.
												builder breakLine. ].
									].	]
! !

"June 28, 2002 -> 15:30:24"!

! (Delta mirrorFor: #ElementUL) methodsFor: 'building' !
buildFor: builder <HTMLBuilder>

	builder breakLine.
	builder indented: self indentWidth
		do: [ super buildFor: builder ].
	builder verticalWhitespace.! !

