	self toolBar addSpace.
	self toolBar
		addButtonWithImageFrom: 'resources/hierarchy.bmp'
				action: [ :b <Button> |	self spawnHierarchy ].
	self toolBar addSpace.
	self	buildOpenCloseChildrenButtons.! !

