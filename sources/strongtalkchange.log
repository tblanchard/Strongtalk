! (Delta mirrorFor: #Button) methodsFor: 'private' !
setState: s <Boolean>

	state := s.
	self hasWin32Handle
		ifTrue: [	| externalState <ExternalData> |
						externalState := s = nil
							ifTrue: [ 2 ]
							ifFalse: [ s asExternalData ].
						self	sendMessage: Win32 BM_SETCHECK
								wparam: externalState
								lparam: Win32 NULL.		]! !

