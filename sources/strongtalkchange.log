! (Delta mirrorFor: #Inspector) methodsFor: 'private' !
printOop: o <Object> ^ <Str>

	^self safePrinting
		ifTrue: [ (VMMirror on: o) safePrintString ] 
		ifFalse: [ o printString ]
! !

