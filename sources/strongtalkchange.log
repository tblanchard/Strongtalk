! (Delta mirrorFor: #ListBox) methodsFor: 'private' !
msgSetSel: state <Boolean> at: zindex <Int>

	(self sendMessage: Win32 LB_SETSEL wparam: state asExternalData lparam: zindex) 
			@= Win32 LB_ERR
		ifTrue: [ Win32 handleError ]! !

