! (Delta mirrorFor: #MethodOutliner) methodsFor: 'private' !
abstractGlyph ^ <Glyph>

	AbstractGlyph isNil
		ifTrue: [ AbstractGlyph :=
						(Image fromWin32File: (FilePath for: 'resources\abstract.bmp'))
							alignLowerLeft. 	].
	^AbstractGlyph
! !

"December 10, 2001 -> 14:18:31"!

! (Delta mirrorFor: #MethodOutliner) methodsFor: 'private' !
alwaysInlineGlyph ^ <Glyph>

	AlwaysInlineGlyph isNil
		ifTrue: [ AlwaysInlineGlyph :=
						(Image fromWin32File: (FilePath for: 'resources\alwaysInline.bmp'))
							alignLowerLeft. 	].
	^AlwaysInlineGlyph
! !

