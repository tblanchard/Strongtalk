hasToolBar ^<Boolean>

	^true! !

"December 10, 2001 -> 14:7:5"!

! (Delta mirrorFor: #OutlinerApp) methodsFor: 'toolbar' !
toolBar ^<ToolBar>

	toolBar isNil
		ifTrue: [	toolBar := ToolBar new.
						self buildToolBar. 	].

	^toolBar! !

