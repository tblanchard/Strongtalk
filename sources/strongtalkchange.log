"December 10, 2001 -> 14:23:53"!

! (Delta mirrorFor: #BubbleSort2Array) methodsFor: 'misc' !
bubbleSort
	| j |
	self size
		to: 1
		by: -1
		do: [:top | 1 to: top - 1 do: [:i | (self at: i)
					> (self at: i + 1)
					ifTrue: 
						[j := self at: i.
						self at: i put: (self at: i + 1).
						self at: i + 1 put: j]]]
! !

"December 10, 2001 -> 14:23:53"!

! (Delta mirrorFor: #BubbleSort2Array) methodsFor: 'misc' !
sort self bubbleSort! !

