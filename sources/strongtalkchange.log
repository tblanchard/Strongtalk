! (Delta mirrorFor: #NestedLoopBenchmark) methodsFor: 'misc' !
nestedLoopTest
	| sum |
	sum := 0.
	1 to: 100 do: [ :i | 1 to: 100 do: [ :j | sum := sum + 1 ] ].
	^ sum! !

