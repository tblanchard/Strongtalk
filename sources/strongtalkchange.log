! (Delta mirrorFor: #Viewport) methodsFor: 'accessing' !
optimizeScrolling: f <Boolean>

	(self hasPart and: [ f ~~ optimizeScrolling ])
		ifTrue: [	"reinstall the client"
						| c <Visual> |
						c := self optimizeScrolling
							ifTrue: [ self part removePart ]
							ifFalse: [ self part ].
						self removePart.
						optimizeScrolling := f.
						self client: c.	].
	optimizeScrolling := f.! !

