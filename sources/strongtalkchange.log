    [ self atEnd or: [ ( self peekFor: $!! ) not ] ] whileFalse: [
        result := result, ( String with: $!! ), ( self upTo: $!! ) ].
    [ self atEnd not and: [ self peek isSeparator ] ]
        whileTrue: [ self next ].
    ^result ! !

