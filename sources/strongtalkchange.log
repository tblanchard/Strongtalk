to: stop <RationalNumber> by: step <RationalNumber> do: f <[RationalNumber]> ^<Object>

	| v <RationalNumber> |
	v := self.
	step < 0
		ifFalse: [ [ v <= stop ]
					whileTrue: [	f value: v.
								v := v + step  ]]
		ifTrue: [ [ v >= stop ]
					whileTrue: [ f value: v.
								v := v + step  ]].
	^nil! !

