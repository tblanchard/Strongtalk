! (Delta mirrorFor: #Activation) classSide methodsFor: 'testing' !
test
	| process <Process> sem <Semaphore> |
	
	sem := Semaphore new.
	
	[
		(OrderedCollection new include: 1; yourself) do: [ :e |
			process := Processor activeProcess.
			sem signal.
			Processor activeProcess suspend.
		]
	] fork.
	sem wait.
	process traceStack.
	process resume.
	
	! !

