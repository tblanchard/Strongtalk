! (Delta mirrorFor: #CharacterReadConverter) classSide methodsFor: 'testing' !
test2

	| f <FilePath> out <CharOutputStream> in <CharInputStream> s <Str> next <Character> |
	f := FilePath for: 'prims.src'.

	in := f charInputStream.
	s := in nextChunk.
	[ (s at: s size) ~= $!! ] verify.
	next := in peek.
	[ next ~= $!! ] verify.
	in close.
! !

