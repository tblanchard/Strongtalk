"December 10, 2001 -> 14:6:7"!

! (Delta mirrorFor: #TakBenchmark) methodsFor: 'misc' !
run
	"TakBenchmark new run"
	| r |
	r := self takX: 18 Y: 12 Z: 6.
	r ~= 7 ifTrue: [ self error: 'tak results are incorrect' ].! !

"December 10, 2001 -> 14:6:7"!

! (Delta mirrorFor: #TakBenchmark) methodsFor: 'misc' !
takX: x Y: y Z: z 
	y < x ifFalse: [^z]
		ifTrue: [^self
				takX: (self
						takX: x - 1
						Y: y
						Z: z)
				Y: (self
						takX: y - 1
						Y: z
						Z: x)
				Z: (self
						takX: z - 1
						Y: x
						Z: y)]! !

