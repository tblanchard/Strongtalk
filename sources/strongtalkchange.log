! (Delta mirrorFor: #TaklBenchmark) methodsFor: 'misc' !
taklX: x Y: y Z: z
	(self shorterpX: y Y: x) ifFalse: [^z]
		ifTrue: [^self
				taklX: (self
						taklX: x cdr
						Y: y
						Z: z)
				Y: (self
						taklX: y cdr
						Y: z
						Z: x)
				Z: (self
						taklX: z cdr
						Y: x
						Z: y)]! !

