! (Delta mirrorFor: #DeltaPrim) methodsFor: 'Unclassified' !
errorCodeString
	| l sig |
	"Construct string"
     l := self getAttribute: #error ifAbsent: [^'{NULL}'].
	sig := '{ '.	
	l do: [ :e |
		sig := sig, '"', e value, '"'
	] andBetweenDo: [
		sig := sig, ', '
	].
	^sig, ', NULL}'! !

