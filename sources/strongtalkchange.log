! (Delta mirrorFor: #Viewport) methodsFor: 'initialization' !
xScrollState: sc <ScrollState>

	xScrollState notNil
		ifTrue: [ xScrollState removeDependent: self ].
	xScrollState := sc.
	sc addDependent: self.! !

