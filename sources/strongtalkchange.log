! (Delta mirrorFor: #HashedCollection) methodsFor: 'private-table manipulation' !
growTable

	| new <Array[A|Object]> |
	new := self newTableWithSize: self table size + self table size.
	self contentsDo:
		[ :val <A> |
			self	lookup: (self keyFor: val)
					inTable: new
					matchingSlotDo:
						[ :index <Int> :val <A> |
							self shouldNotHappen	]
					emptySlotDo:
						[ :index <Int> |
							new at: index put: val	]
					deletedSlotsDo:
						[ :index <Int> |
							self shouldNotHappen ]
					mismatchingSlotsDo:
						[ :index <Int> | "ignore" ]
		].
	self deleted: 0.
	self table: new.! !

