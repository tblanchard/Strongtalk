! (Delta mirrorFor: #Launcher) methodsFor: 'menus' !
docMenu ^<Menu>

	^Menu new
			add: (Menu new name: '&Documentation';
						add: (MenuAction new
									name: '&Browse';
									action: [ (HTMLView new model: (URL forFilePath: self docPath)) launch ])
					  )! !

