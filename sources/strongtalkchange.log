! (Delta mirrorFor: #EnterLeaveHandler) methodsFor: 'private' !
recordEnter

	self	inside: true.
! !

"December 10, 2001 -> 14:2:10"!

! (Delta mirrorFor: #EnterLeaveHandler) methodsFor: 'private' !
recordLeave

	self isGrabbing
		ifTrue: [ self releaseGrab ].
	self inside: false.
! !

"December 10, 2001 -> 14:2:10"!

! (Delta mirrorFor: #EnterLeaveHandler) methodsFor: 'notification' !
