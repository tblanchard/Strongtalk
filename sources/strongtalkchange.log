! (Delta mirrorFor: #Scroller) methodsFor: 'restricted-win32' !
handleMouseWheelWithWParam: wParam <ExternalData>    ^<ExternalData>

	| wheelDist <Int> dist <Int>  |
	wheelDist := wParam asExternalProxy highSigned.
	
	"The dist is in bogus units of 120 per wheel increment on current mice, so let's do something
	  that would be equivalent to moving about 1 text line for each click.  Let's guestimate for
	  now that 1 wheel increment is about 14 pixels, so 120/14=~9."
	dist := wheelDist // 9.
	self yScrollState scrollPosition: self yScrollState scrollPosition + dist.
	^0! !

