! (Delta mirrorFor: #VisualWithNativeWindow) methodsFor: 'accessing' !
backgroundPainter ^<Painter>

	backgroundPainter isNil
		ifTrue: [  backgroundPainter := self part backgroundPainter ].
	^backgroundPainter! !

