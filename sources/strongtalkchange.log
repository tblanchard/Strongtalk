! (Delta mirrorFor: #URL) classSide methodsFor: 'private' !
pathForAbsoluteFilePath: fp <FilePath>  ^<Str>

	^'file:///', 
			(String withAll:
				(fp name collect:
						[ : c <Character> |
							c = $\
								ifTrue: [ $/ ]
								ifFalse: [ c = $:
													ifTrue: [ $| ]
													ifFalse: [ c ]
												 ]
						]
				 )
			).! !

