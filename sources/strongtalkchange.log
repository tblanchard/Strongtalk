! (Delta mirrorFor: #LivermoreBenchmark) methodsFor: 'misc' !
run
	|	n size x y q r z t |

	n := 1001.
	size := n + 12.
	x := Array new: size.
	y := (Array new: size) atAllPut: 1.1234.
	z := (Array new: size) atAllPut: 1.1234.
	q := r := t := 1.234.

	100 "1000" timesRepeat: [
		1 to: n do: [ :k  |
			x at: k put: (q + ( (y at: k) * (r*(z at: k + 10)) + (t*(z at: k + 11)) ))
		]
	]


! !

