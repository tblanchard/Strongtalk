! (Delta mirrorFor: #ListBox) methodsFor: 'private' !
addBackgroundTo: v <Visual> ^<Visual>

	^v withBackdrop: self backPainter! !

"December 10, 2001 -> 14:1:21"!

! (Delta mirrorFor: #ListBox) methodsFor: 'private' !
backPainter ^<Painter>

	BackPainter isNil
		ifTrue: [ BackPainter := Painter new paint: self selectionPaint ].
	^BackPainter! !

