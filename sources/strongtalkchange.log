= other <Object> ^<Boolean>

	^self == other
		or: [ self class = other class
				and: [ "We have the same class, so we can guarantee other is a SeqCltn"
					  self hasSameElementsAndOrderAs: (guaranteed <SeqCltn[Object]> other)   ]]! !

