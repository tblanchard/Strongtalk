! (Delta mirrorFor: #TextEditor) methodsFor: 'private' !
reloadTextView

	"We do this even if no edits because the file might have changed"
	self hasPath
		ifTrue: [ self doOpen ]
		ifFalse: [	self textView model: OrderedCollection[CharacterGlyph] new  ]! !

