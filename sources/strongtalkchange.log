typecheckSelector: sel <Symbol>

	| m <DeltaMethod> tmp <DeltaMethod> methodHasBody <Boolean> |
	
	m := self methodAt: sel ifFail: [self error: 'Method not found'].
	methodHasBody := m body notNil.
	[
		methodHasBody
