! (Delta mirrorFor: #Application) methodsFor: 'control' !
inSessionProcessDo: blk <[]>

	"First check if the visual and session is present"
	(visual isNil or: [ self session isNil ]) 
		ifTrue: [^self].
	
	self session inProcessDo: blk! !

