! (Delta mirrorFor: #Application) methodsFor: 'private' !
buildVisualTop: forTop <Boolean> ^ <Visual>

	| v <Visual> |
	v := self buildBareVisualTop: forTop.
	(forTop not or: [ self hasPopUpMenuForTop ])
		ifTrue: [	self hasMenu
							ifTrue: [ v := v withPopUpMenuSource: [ self popUpMenu ] ] ].
	^v! !

