! (Delta mirrorFor: #Mandelbrot) methodsFor: 'computation' !
oldmandelbrotFrom: a <Point>
to: b <Point>
width: width <Int>
height: height <Int>
steps: steps <Int>
do: renderBlock <[Int,Int,Int]>
	|
	i
	j
	x <FloatValue>
	y <FloatValue>
	dx <FloatValue>
	dy <FloatValue>
	|
	dx := ((b x - a x) / width) asFloatValue.
	dy := ((b y - a y) / height) asFloatValue.

	y := a y asFloatValue.
	j := 0.
	[ j < height ] whileTrue: [
		x := a x asFloatValue.
		i := 0.
		[ i < width ] whileTrue: [
			renderBlock value: i value: j value: (self iterateAt_re: x asFloat im: y
asFloat steps: steps).
			x := x + dx.
			i := i + 1
		].
		y := y + dy.
		j := j + 1
	]
! !

