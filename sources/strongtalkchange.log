hasWinBackdrop ^<Boolean>

	^true! !

"December 10, 2001 -> 14:29:11"!

! (Delta mirrorFor: #CoreSampler) methodsFor: 'private' !
showCore

	column removeAll.
	core do:
		[ :g <Glyph> |
			column add:
				(ProgrammingEnvironment new
					buildLabel: g printString 
					painter: Painter default
					action: [ (Inspector on: g) launch ]
				)
		].
	core := nil.! !

