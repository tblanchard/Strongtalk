! (Delta mirrorFor: #MessageDeclarationOutliner) methodsFor: 'private' !
setCodeView

	self codeView: ((self buildCodeViewGetModel: [ self sourceAsCharGlyphs ]
									setModelOnSuccess: [ :blk <[]> | self storeAndOnSuccess: blk ])
									codeManager: self).! !

