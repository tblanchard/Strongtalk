! (Delta mirrorFor: #ElementLI) methodsFor: 'building' !
buildFor: builder <HTMLBuilder>

	builder breakLine.
	builder indented: -15
		do: [	self addBulletGlyphTo: builder.
					builder indented: 15
						do: [	super buildFor: builder ]
				].
	builder breakLine.! !

"December 10, 2001 -> 14:13:25"!

! (Delta mirrorFor: #ElementLI) methodsFor: 'building' !
oldbuildFor: builder <HTMLBuilder>

	| orig <Int> |
	builder breakLine.
	orig := builder currentWidth.
	self addBulletGlyphTo: builder.
	self addAfterBulletGlyphTo: builder.
	builder indented: builder currentWidth - orig
		do: [ super buildFor: builder ].
	builder breakLine.! !

