! (Delta mirrorFor: #ExternalProxy) methodsFor: 'printing' !
printValueOn: strm <CharOutStream>

	strm show: '16r'.
	4 to: 1 by: -1
		do: [ :i <Int> |
				strm put: (self high hexDigitAt: i) ].
	4 to: 1 by: -1
		do: [ :i <Int> |
				strm put: (self low hexDigitAt: i) ].! !

