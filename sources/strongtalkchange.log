	"Change this once we have a good way of browsing anonymous invocations"
	| sc <AbstractClassMirror> |
	sc := self mirror superclass.
	[ sc isMixinInvocation ] whileTrue: [ 
		sc := sc superclass ].
	(DefWithMsgOutliner on: sc) launch! !

