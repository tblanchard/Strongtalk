! (Delta mirrorFor: #HashedCollection) methodsFor: 'private-table manipulation' !
contentsDo: f <[A]>

	| tbl <Array[A|Object]> |
	tbl := self table.
	tbl == nil
		ifTrue: [ ^self ].

	1 to: tbl size do:
		[ :index <Int> |
			self atIndex: index
					inTable: tbl
					occupiedSlotDo:
						[ :val <A> |
							f value: val	]
					emptySlotDo: [ ]
					deletedSlotDo: [ ]
		]
! !

