indexFor: el <E> ^<Int>
	"This returns an internal index such that if el was inserted before it
	  the collection would remain sorted"

	^self contents
		binarySearchFor: el
		between: self startGap + 1
		and: self lastIndex
		toCompare: self sortBlock
"	| low <Int> high <Int> |
	low := self startGap + 1.
