! (Delta mirrorFor: #TextEditor) methodsFor: 'private' !
promptOpen

	self visual
		userPickOpenFileWithAction:
			[ :f <FilePath> :writeable <Boolean> |
				self path: f 	]
		fileTypes: (Array[Tuple[Str,Str]] with: 'All Files' ,, '*.*' with: 'Text Files' ,, '*.txt' )
		defaultFile: path
		defaultDir: nil
		title: 'Open File'
		allowReadOnly: true
		mustExist: true! !

