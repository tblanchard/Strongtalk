! (Delta mirrorFor: #Palette) methodsFor: 'control' !
release

	win32Handle notNil
		ifTrue: [	Palette debugging
							ifTrue: [ Platform errorStream show: 'Palette>>releasing'; cr.	].
						win32Handle win32DeleteObject.
						win32Handle := nil	]! !

