! (Delta mirrorFor: #SeqCltnReadWriteStream) methodsFor: 'private' !
actualNext ^<E>

	| pos <Int> |
	pos := self actualPosition.
	pos := pos + 1.
	pos > self size
		ifTrue: [ self error: 'Attempt to read past the end of a stream' ].
	self actualPosition: pos.
	^self buffer at: pos! !

