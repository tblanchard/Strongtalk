! (Delta mirrorFor: #SmallInteger) classSide methodsFor: 'testing' !
test

	| r <Random> |
	r := Random new.
	-10000 to: 10000 do:
		[ :i <Int> |
			| strm <CharReadWriteStream> ps <Str> norm <Str> |
			strm := (String new: 5) writeStream.
			i printOn: strm.
			ps := i printString.
			norm := strm contentsWritten.
			[ ps = strm contentsWritten ] verify.
		].! !

