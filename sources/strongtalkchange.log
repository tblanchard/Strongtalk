! (Delta mirrorFor: #Character) methodsFor: 'accessing' !
digitValue ^<Int>

	| c <Int> |
	c := code.	 	
	^(c >= 48 and: [ c <= 57 ])
		ifTrue: [ c - 48 ] 									"(48= $0 asInteger)"
		ifFalse: [ (c >= 65 and: [ c <= 90 ])					" $A = 65, $Z = 90"
					ifTrue: [ c - 55 ]
					ifFalse: [ (c >=97 and: [ c <= 122 ])  	"$a = 97, $z = 122"
								ifTrue: [ c - 87 ]
								ifFalse: [ -1 ]	]]! !

