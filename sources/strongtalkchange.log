! (Delta mirrorFor: #SortedCollection) methodsFor: 'private' !
partition: low <Int> to: high <Int> ^<Int>

	|	tbl 		<Array[E]>
		pivot 	<Int> 
		atPivot <E>
		up 		<Int> 
		atUp 	<E> 
		down 	<Int> 
		atDown <E>  |

	tbl := self contents.
	atPivot := tbl at: low.
	pivot := down := low.
	up := high.
	[	[  (up > down or: [ atUp := tbl at: up. 	false ])
				and: [ (self element: (atUp := tbl at: up) isBefore: atPivot) not  ]		]
			whileTrue: [ up := up - 1 ].
		pivot := up.
		up == down
			ifFalse: [	tbl at: down put: atUp.
							[ (down < up or: [ atDown := tbl at: down.	  false ])
									 and: [ (self element: atPivot isBefore: (atDown := tbl at: down)) not ]  ]
								whileTrue: [ down := down + 1 ].
							pivot := down.
							down == up
								ifFalse: [ tbl at: up put: atDown ]
								ifTrue: [	tbl at: pivot put: atPivot.
												^pivot	].	]
			ifTrue: [	tbl at: pivot put: atPivot.
							^pivot	].
		] repeat.! !

