! (Delta mirrorFor: #Integer) methodsFor: 'iteration' !
to: stop <Int> by: step <Int> do: f <[Int]> ^<Object>

	| v <Int> |
	v := self.
	step < 0
		ifFalse: [ [ v <= stop ]
					whileTrue: [	f value: v.
								v := v + step  ]]
		ifTrue: [ [ v >= stop ]
					whileTrue: [ f value: v.
								v := v + step  ]].
	^nil! !

