! (Delta mirrorFor: #Win32Control) methodsFor: 'private' !
cleanUp

	self isFocus
		ifTrue: [	self nativeWindow ignoreNextFocusSet: true.
						self session noInputFocus. ].
	self destroyWin32Handle.
! !

