    | t1Dict <IdentityDictionary[ObjectType, Boolean]>  |

t1Dict := self dict at: t1
                      ifAbsent:[self dict at: t1 put: IdentityDictionary[ObjectType, Boolean]  new].
(t1Dict includesIndex: t2) ifFalse:[t1Dict at: t2 put: false]
