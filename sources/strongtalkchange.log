! (Delta mirrorFor: #Win32Control) classSide methodsFor: 'private' !
controls ^<VarDict[Int, Win32Control]>

	"Assumption: allers must be in a critical region for self"

	Controls isNil
		ifTrue: [ Controls := Dictionary[Int, Win32Control] new ].
	^Controls! !

