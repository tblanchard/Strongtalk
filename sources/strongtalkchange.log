test ^ <Str>

^self transform: 'Jo seeks  "Jo" (Jo) for: fun + travel'
		using:[: s <Symbol> :v <Object> :str <Str> | s  = #identifier  ifTrue:[v = #Jo ifTrue:[#Joe] ifFalse:[str]] ifFalse:[str]]
		ifFail:[:s <Str>  :i <Int> | self error: s].! !

