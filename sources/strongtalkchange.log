! (Delta mirrorFor: #DeltaHCode) methodsFor: 'Unclassified' !
symbolOopsDo: aBlock
	| e |
	1 to: code size do: [ :i |
		(self holdsOopAt: i) ifTrue: [
			e := self at: i.
			e isOop ifTrue: [
				e isSymbolOop
					ifTrue: [ aBlock value: e ]
					ifFalse: [ e isMethodOop ifTrue: [e symbolOopsDo: aBlock ] ] ] ] ]


"
    code do: [ :e | (e isSmallInteger or: [e isCharacter]) ifFalse: [
        e isSymbolOop
            ifTrue: [ aBlock value: e ]
            ifFalse: [ e isMethodOop ifTrue: [e symbolOopsDo: aBlock ]]]]
"! !

