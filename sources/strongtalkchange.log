! (Delta mirrorFor: #UI) classSide methodsFor: 'testing' !
test1

	|	hInstance <ExternalProxy>
		hwnd <ExternalProxy>
		hwnd2 <ExternalProxy>
		msg <MSG>
		|
	hInstance := self hInstance.
	self registerWinClassFor: hInstance.
	"self setBatchLimit: 50."

	hwnd := self createWindowFor: hInstance parent: Win32 NULL.
	hwnd2 := self createChildWindowFor: hInstance parent: hwnd.
	self showWindow: hwnd; showWindow: hwnd2.
	"self updateWindow: hwnd; updateWindow: hwnd2."
	msg := MSG new allocate.
	[ | t | Transcript show: 'waiting... '. t := self getMessage: msg. Transcript show: ' got: '. t ]
		whileTrue:
			[	Transcript print: msg; show: ' window: '; print: msg hwnd; cr.
				self translateMessage: msg.
				Transcript show: '*'.
				self dispatchMessage: msg.  ].
	msg free.
Transcript show: 'done'; cr.
! !

