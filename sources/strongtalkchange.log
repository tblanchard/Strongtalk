! (Delta mirrorFor: #VisualWithNativeWindow) methodsFor: 'accessing' !
gridFor: p <Point> ^<Rect>

	| partpos <Point> |

	partpos := self part position.
	^(self part gridFor: p - partpos) translatedBy: partpos! !

