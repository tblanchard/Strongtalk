! (Delta mirrorFor: #ClassHierarchyOutliner) methodsFor: 'incremental searching' !
resetSearch

	"Reset the incremental search state"
	lastSearch					:= ''.
	lastSearchNumber	:= 1.
	lastEventTime			:= 0.! !

