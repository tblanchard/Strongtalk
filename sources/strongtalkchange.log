! (Delta mirrorFor: #StackTraceInspector) methodsFor: 'control' !
transferToConsoleDebugger

	self process stopInEvaluator.
	self process: nil.		"Don't terminate process when window closes"
	self requestCloseIfTopWindow.
! !

