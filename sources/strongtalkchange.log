closeRequest: toClose <[]>

	self visual
				promptYesNoCancel: 'Save system before exiting?'
				title: 'Quit'
				type: #exclamation
				default: 3
				action: [ :ok <Boolean|Nil> |
								ok = nil
									ifFalse: [	ok == true ifTrue: [ Dumper saveSystem ].
														toClose value.
														VM quit.		]
								]! !

