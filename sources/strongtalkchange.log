! (Delta mirrorFor: #DeltaHCodeGenerator) methodsFor: 'Unclassified' !
while: cond jumpTo: pos
	| offs |
	offs := code size - pos.
	self assert: [ offs >= 0 ].
	offs < 16r100
		ifTrue: [
			"use short jumps"
			code
				byte:
					(cond
						ifTrue: [ 16r74 ]
						ifFalse: [ 16r75 ]
					)
				byte: offs
		]
		ifFalse: [
			"use long jumps"
			"self assert: [ offs < 16r100000000 ]."
			code
				byte:
					(cond
						ifTrue: [ 16r7C ]
						ifFalse: [ 16r7D ]
					)
				word: offs
		].
	code killLast! !

